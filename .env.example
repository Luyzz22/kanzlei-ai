DATABASE_URL=postgresql://user:password@localhost:5432/kanzleiai
DIRECT_URL=postgresql://user:password@localhost:5432/kanzleiai
NEXTAUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI Model Configuration (alle optional — ohne Key wird der Anbieter übersprungen)
# Werte NIE hier eintragen: echte Keys gehören ausschliesslich in den Secret
# Manager. Platzhalter bewusst ohne echtes Präfix, damit Secret-Scanner und
# Entwickler sie nicht für gültige Credentials halten.
ANTHROPIC_API_KEY=__SET_IN_SECRET_MANAGER__
# OPENAI_API_KEY / GEMINI_API_KEY gibt es nicht mehr: OpenAI und Gemini sind
# nach ADR-0001 stillgelegt, die SDKs deinstalliert. Ein gesetzter Key hätte
# keinerlei Wirkung.

# Lokaler OpenAI-kompatibler Endpunkt — die souveräne Zone (Hetzner/On-Prem).
# Trägt Klasse 3–4; spricht reines HTTP, kein Anbieter-SDK.
# Zielbild nach docs/adr/0002-lokales-modell-vertragsanalyse.md:
#   vLLM auf Hetzner GEX131 (RTX PRO 6000 Blackwell, 96 GB)
#   LLAMA_MODEL=mistralai/Mistral-Small-4-119B-2603   (4-bit, ~60 GB VRAM)
# vLLM muss mit aktivierter guided decoding laufen — die Pipeline schickt das
# JSON-Schema jeder Stufe mit und erzwingt damit schema-valide Ausgaben.
LLAMA_API_KEY=
LLAMA_API_BASE=
LLAMA_MODEL=

# API-Modell-IDs — WICHTIG: datierte Snapshots für reproduzierbare Output-Limits
# Alias (claude-sonnet-4-5) kann sich still ändern und andere max_tokens-Limits haben.
# Empfohlen Production (wenn 4.6 auf dem Konto verfügbar): claude-sonnet-4-6-20260217
# Sonnet 4.5 Snapshot (häufig verfügbar): claude-sonnet-4-5-20250929
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5-20250929

# Anthropic: Alias → Snapshot-Mapping (Default true). false = ENV-Wert 1:1 an API
AI_ANTHROPIC_PIN_ALIASES=true

# ── Claude über Amazon Bedrock ─────────────────────────────────────────────
# Nach ADR-0001 der externe Pfad für Mandatsdaten (docs/adr/0001-…).
# Default aus → direkte Anthropic-API mit ANTHROPIC_API_KEY. true = alle Claude-
# Aufrufe über AWS Bedrock (dann KEIN ANTHROPIC_API_KEY nötig).
AI_BEDROCK_ENABLED=false
# PFLICHT bei AI_BEDROCK_ENABLED=true. Es gibt bewusst KEINEN Default:
# fehlende oder nicht-EU Region blockiert den Start des Clients, statt still
# nach us-east-1 zu routen. Zulässig sind nur EU-Mitgliedstaat-Regionen —
# eu-west-2 (London) und eu-central-2 (Zürich) gehören NICHT dazu.
AWS_BEDROCK_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=          # leer lassen bei IAM-Rolle/Instance-Profile
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # nur bei temporären STS-Credentials
# AWS_PROFILE=                # alternativ zu Keys (lokale Dev)
# BEDROCK_ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_INFERENCE_PROFILE_PREFIX=eu

# Vertragsanalyse: nur Claude Sonnet, kein stilles Fallback auf OpenAI/Gemini (Default true).
# Für lokale Dev ohne Anthropic: AI_CONTRACT_ANALYSIS_CLAUDE_ONLY=false
AI_CONTRACT_ANALYSIS_CLAUDE_ONLY=true

# Risk-Stage ab dieser Dokumentlänge in 2 Phasen (Findings + Guidance)
AI_RISK_SPLIT_CHAR_THRESHOLD=25000

# v5 Async Worker (Stage-Chunked Pipeline)
WORKER_TOKEN=

# Model Selection Strategy (Legacy + Router-Hinweise)
DEFAULT_MODEL=claude-sonnet-4
LONG_DOCUMENT_MODEL=claude-sonnet-4
SIMPLE_QUERY_MODEL=claude-sonnet-4
MAX_TOKENS_CLAUDE=200000

# Multi-Modell-Router / Pipeline
AI_ROUTER_ENABLED=true
AI_PROVIDER_PRIORITY=anthropic,llama
AI_LONG_DOCUMENT_CHAR_THRESHOLD=50000
AI_MAX_INPUT_CHARS=120000
AI_SENSITIVE_USE_LLAMA=false
AI_AUDIT_VERBOSE=false
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_MICROSOFT_ALLOWED_TENANT_IDS=
AUTH_MICROSOFT_ADMIN_ROLES=
# SCIM nur setzen, wenn Provisioning aktiv genutzt wird
SCIM_BEARER_TOKEN=
SCIM_TENANT_SLUG=
SCIM_GROUP_ADMIN=KanzleiAI.Admin
SCIM_GROUP_ANWALT=KanzleiAI.Anwalt
SCIM_GROUP_ASSISTENT=KanzleiAI.Assistent
SCIM_BEARER_TOKENS=
SCIM_ALLOWED_IPS=
