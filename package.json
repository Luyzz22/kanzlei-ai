{
  "name": "kanzlei-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://user:password@localhost:5432/kanzleiai} DIRECT_URL=${DIRECT_URL:-${DATABASE_URL:-postgresql://user:password@localhost:5432/kanzleiai}} prisma generate",
    "prisma:migrate": "DIRECT_URL=${DIRECT_URL:-$DATABASE_URL} prisma migrate dev",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://user:password@localhost:5432/kanzleiai} DIRECT_URL=${DIRECT_URL:-${DATABASE_URL:-postgresql://user:password@localhost:5432/kanzleiai}} prisma validate",
    "typecheck": "next typegen && tsc --noEmit",
    "eval:contracts": "EVAL_MOCK=true NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/run-contract-evals.ts",
    "eval:contracts:persist": "EVAL_MOCK=true EVAL_PERSIST_DB=1 NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/run-contract-evals.ts -- --persist",
    "eval:normpilot": "NORMPILOT_EVAL_MOCK=true NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.json scripts/run-normpilot-evals.ts",
    "smoke:normpilot": "node scripts/normpilot-smoke-check.mjs",
    "security:llm-egress": "node scripts/check-llm-egress.mjs",
    "test": "AI_CONTRACT_ANALYSIS_CLAUDE_ONLY=false NODE_OPTIONS=--conditions=react-server tsx --test src/lib/ai/__tests__/*.test.ts src/lib/compliance/__tests__/*.test.ts src/lib/documents/__tests__/*.test.ts src/lib/security/__tests__/*.test.ts src/lib/evals/__tests__/contract-eval-runner.test.ts src/lib/evals/__tests__/eval-model-matrix.test.ts src/lib/normpilot/__tests__/*.test.ts",
    "security:deny-terms": "node scripts/check-deny-terms-sync.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.32.4",
    "@anthropic-ai/sdk": "^0.78.0",
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.6.2",
    "unpdf": "^1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "vite": "8.3.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "glob": ">=10.5.0",
      "next>postcss": "8.5.33",
      "vite@>=8 <8.1.6": "8.3.8",
      "zod@>=4 <4.6.6": "4.6.7"
    }
  }
}
